# ── LLM backend ───────────────────────────────────────────────────────────────
# Which LLM provider to use: 'openai' (default) or 'ollama'
LLM_BACKEND=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama (only needed when LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# ── Persistence ───────────────────────────────────────────────────────────────
# File-backed DuckDB database.  Leave as :memory: for ephemeral sessions.
# Set to a file path (e.g. ./data/niq.duckdb) to persist across restarts.
DUCKDB_PATH=:memory:

# Directory where ingested Parquet files are written.
PARQUET_STORE=./data/parquet

# ── LangGraph ─────────────────────────────────────────────────────────────────
LANGGRAPH_API_KEY=
